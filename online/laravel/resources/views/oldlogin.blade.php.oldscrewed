       <script type="text/javascript">
        $('#username,#password').keyboard({openOn : null });

        $('.username').click(function(){
          var kb = $('#username').getkeyboard();
          kb.reveal()
        })
        $('.password').click(function(){
          var kb = $('#password').getkeyboard();
          kb.reveal()
        })
      </script>
